# MCP Server Configuration
# Transport type: stdio, http, https, sse
NOTEBOOKLM_MCP_TRANSPORT=http

# Host and port configuration
NOTEBOOKLM_MCP_HOST=0.0.0.0
NOTEBOOKLM_MCP_PORT=8000

# MCP endpoint path
NOTEBOOKLM_MCP_PATH=/mcp

# Stateless mode for horizontal scaling
NOTEBOOKLM_MCP_STATELESS=false

# Debug logging
NOTEBOOKLM_MCP_DEBUG=false

# Query timeout in seconds
NOTEBOOKLM_QUERY_TIMEOUT=120.0

# SSL configuration (for HTTPS transport)
# NOTEBOOKLM_MCP_SSL_CERT=/path/to/cert.pem
# NOTEBOOKLM_MCP_SSL_KEY=/path/to/key.pem

# Let's Encrypt configuration (for HTTPS transport)
# NOTEBOOKLM_MCP_LETS_ENCRYPT=true
# NOTEBOOKLM_MCP_DOMAIN=your-domain.com

# Interface language and default artifact language
NOTEBOOKLM_HL=en

# Database configuration (if using external database)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=notebooklm
# DB_USER=notebooklm
# DB_PASSWORD=your-password
